# Copy to terraform.tfvars and adjust. Do NOT commit terraform.tfvars.
# terraform.tfvars is gitignored (may contain environment-specific values).

aws_region  = "us-east-1"
project     = "netflow"
environment = "prod"

vpc_cidr           = "10.0.0.0/16"
az_count           = 3
single_nat_gateway = true

kubernetes_version  = "1.30"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
node_disk_size      = 20
node_capacity_type  = "ON_DEMAND"   # or "SPOT" for cheaper, interruptible nodes

# IMPORTANT: restrict this to your office/VPN CIDRs in production.
cluster_public_access_cidrs = ["0.0.0.0/0"]

ecr_repositories = ["netflow-backend", "netflow-frontend"]
