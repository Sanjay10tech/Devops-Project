# Root environment for docker-compose (copy to .env for local development).
# No secrets are committed; these are local development defaults only.

# Database
DB_NAME=netflix
DB_USER=netflix
DB_PASSWORD=netflix
DB_PORT=5432

# Host ports
BACKEND_PORT=4000
FRONTEND_PORT=8080

# Backend
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info
