# Backend environment configuration (copy to .env for local development)
# No secrets are committed to the repo. Provide real values locally / via a secret manager in prod.

NODE_ENV=development
PORT=4000

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netflix
DB_USER=netflix
DB_PASSWORD=netflix

# CORS: comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info
