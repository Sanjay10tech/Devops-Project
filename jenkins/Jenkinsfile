// =============================================================================
// Netflow — Production-grade Jenkins CI pipeline (declarative).
//
// Responsibility: build, test, scan, publish immutable images, and update the
// GitOps desired state. Deployment is performed by ArgoCD reconciling the GitOps
// repo — Jenkins NEVER applies to Kubernetes directly.
//
// Stages:
//   1. Checkout                 9. Dependency Vulnerability Scan
//   2. Environment Validation  10. Trivy Filesystem Scan
//   3. Install Dependencies    11. Docker Image Build
//   4. Lint                    12. Trivy Container Image Scan
//   5. Unit Tests              13. Image Tagging
//   6. Test Coverage           14. Push Image to Registry
//   7. Static Code Analysis    15. GitOps Deployment Update
//   8. SonarQube Analysis
//
// Reproducibility: pinned tool versions (agent), immutable git-SHA image tags,
// npm ci against committed lockfiles, no `latest` in deployment.
// =============================================================================

pipeline {
  agent any

  parameters {
    string(name: 'TRIVY_SEVERITY',       defaultValue: 'HIGH,CRITICAL', description: 'Severities that fail Trivy scans')
    string(name: 'OWASP_FAIL_ON_CVSS',   defaultValue: '7',             description: 'Fail dependency scan on CVSS >= this value')
    string(name: 'MIN_COVERAGE',         defaultValue: '70',            description: 'Minimum backend line coverage % required')
    booleanParam(name: 'UPDATE_GITOPS',  defaultValue: true,            description: 'Update the GitOps desired state on success')
  }

  options {
    timestamps()
    ansiColor('xterm')
    timeout(time: 60, unit: 'MINUTES')          // hard pipeline timeout
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '15'))
    skipStagesAfterUnstable()
  }

  environment {
    // --- Registry / image coordinates (override via Jenkins env or folder props) ---
    AWS_REGION      = "${env.AWS_REGION ?: 'us-east-1'}"
    ECR_REGISTRY    = "${env.ECR_REGISTRY ?: '000000000000.dkr.ecr.us-east-1.amazonaws.com'}"
    BACKEND_IMAGE   = "${ECR_REGISTRY}/netflow-backend"
    FRONTEND_IMAGE  = "${ECR_REGISTRY}/netflow-frontend"

    // --- SonarQube server name (Manage Jenkins > System) ---
    SONARQUBE_ENV   = 'sonarqube'

    // --- GitOps repo (config repo ArgoCD watches) ---
    GITOPS_REPO     = "${env.GITOPS_REPO ?: 'https://github.com/Sanjay10tech/Devops-Project-gitops.git'}"
    GITOPS_BRANCH   = "${env.GITOPS_BRANCH ?: 'main'}"
    GITOPS_OVERLAY  = "${env.GITOPS_OVERLAY ?: 'k8s/overlays/prod'}"

    // Directory for archived reports.
    REPORTS_DIR     = 'reports'
  }

  stages {

    // 1 ----------------------------------------------------------------- Checkout
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_SHA       = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
          env.GIT_SHA_FULL  = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.IMAGE_TAG     = env.GIT_SHA            // immutable tag — never 'latest'
          echo "Commit: ${env.GIT_SHA_FULL} | image tag: ${env.IMAGE_TAG}"
        }
        sh "mkdir -p ${REPORTS_DIR}/coverage ${REPORTS_DIR}/lint ${REPORTS_DIR}/trivy ${REPORTS_DIR}/dependency-check ${REPORTS_DIR}/tests"
      }
    }

    // 2 --------------------------------------------------- Environment Validation
    stage('Environment Validation') {
      steps {
        // Verify required tooling exists on the agent. Fail fast with a clear message.
        sh '''
          set -e
          echo "Validating build environment..."
          for tool in node npm docker trivy aws kustomize git hadolint kube-linter; do
            if ! command -v "$tool" >/dev/null 2>&1; then
              echo "ERROR: required tool '$tool' not found on the agent" >&2
              exit 1
            fi
          done
          # dependency-check may be a wrapper script name; check both.
          command -v dependency-check.sh >/dev/null 2>&1 || command -v dependency-check >/dev/null 2>&1 || {
            echo "ERROR: OWASP dependency-check CLI not found" >&2; exit 1; }

          echo "node:   $(node --version)"
          echo "npm:    $(npm --version)"
          echo "docker: $(docker --version)"
          echo "trivy:  $(trivy --version | head -n1)"
        '''
        // Verify Docker daemon reachability without leaking anything sensitive.
        sh 'docker info >/dev/null 2>&1 || { echo "ERROR: Docker daemon not reachable" >&2; exit 1; }'
      }
    }

    // 3 ------------------------------------------------- Install Dependencies
    stage('Install Dependencies') {
      options { retry(2) }   // tolerate transient registry/network failures
      parallel {
        stage('backend') {
          steps {
            dir('backend') {
              sh 'if [ -f package-lock.json ]; then npm ci; else npm install; fi'
            }
          }
        }
        stage('frontend') {
          steps {
            dir('frontend') {
              sh 'if [ -f package-lock.json ]; then npm ci; else npm install; fi'
            }
          }
        }
      }
    }

    // 4 ------------------------------------------------------------------- Lint
    stage('Lint') {
      parallel {
        stage('backend') {
          steps {
            dir('backend') {
              sh 'npm run typecheck'
              // Emit a machine-readable report for archiving; still fail on error.
              sh 'npm run lint -- -f json -o ../reports/lint/backend-eslint.json || (npm run lint; exit 1)'
            }
          }
        }
        stage('frontend') {
          steps {
            dir('frontend') {
              sh 'npm run typecheck'
              sh 'npm run lint -- -f json -o ../reports/lint/frontend-eslint.json || (npm run lint; exit 1)'
            }
          }
        }
      }
    }

    // 5 ------------------------------------------------------------- Unit Tests
    stage('Unit Tests') {
      steps {
        dir('backend') {
          // JUnit output for Jenkins test trend reporting.
          sh 'npm test -- --reporter=junit --outputFile=../reports/tests/backend-junit.xml'
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'reports/tests/backend-junit.xml'
        }
      }
    }

    // 6 ---------------------------------------------------------- Test Coverage
    stage('Test Coverage') {
      steps {
        dir('backend') {
          sh 'npm run test:coverage'
          // Copy coverage artifacts to the reports dir for archiving + Sonar.
          sh 'cp -r coverage ../reports/coverage/backend || true'
        }
        // Enforce the minimum coverage threshold; fail the build if below.
        script {
          def summaryPath = 'backend/coverage/coverage-summary.json'
          if (fileExists(summaryPath)) {
            def summary = readJSON file: summaryPath
            def pct = summary.total.lines.pct as BigDecimal
            echo "Backend line coverage: ${pct}% (minimum ${params.MIN_COVERAGE}%)"
            if (pct < (params.MIN_COVERAGE as BigDecimal)) {
              error "Coverage ${pct}% is below the required minimum ${params.MIN_COVERAGE}%"
            }
          } else {
            echo "WARN: coverage-summary.json not found; ensure the json-summary reporter is enabled."
          }
        }
      }
    }

    // 7 --------------------------------------------------- Static Code Analysis
    stage('Static Code Analysis') {
      steps {
        // 7a. Dockerfile lint (hadolint) — security + best-practice gate.
        sh """
          hadolint backend/Dockerfile frontend/Dockerfile \
            | tee ${REPORTS_DIR}/hadolint.txt
        """
        // 7b. IaC / Kubernetes / Dockerfile misconfiguration scan (Trivy config).
        //     Report for archiving, then a GATING run that fails on the threshold.
        sh """
          trivy config --severity ${params.TRIVY_SEVERITY} \
            --format table --output ${REPORTS_DIR}/trivy/config-scan.txt --no-progress .
        """
        sh """
          trivy config --severity ${params.TRIVY_SEVERITY} --exit-code 1 --no-progress .
        """
        // 7c. Kubernetes manifest security lint (kube-linter) over the rendered base.
        sh """
          kube-linter lint k8s/base \
            | tee ${REPORTS_DIR}/kube-linter.txt
        """
      }
    }

    // 8 -------------------------------------------------------- SonarQube Analysis
    stage('SonarQube Analysis') {
      steps {
        script {
          def scannerHome = tool 'sonar-scanner'
          withSonarQubeEnv("${SONARQUBE_ENV}") {   // injects URL + token, not logged
            sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectVersion=${IMAGE_TAG}"
          }
        }
      }
    }

    stage('SonarQube Quality Gate') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true   // fail the build on a failing gate
        }
      }
    }

    // 9 ------------------------------------------- Dependency Vulnerability Scan
    stage('Dependency Vulnerability Scan') {
      options { retry(2) }   // NVD data fetch can be flaky
      steps {
        withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
          // set +x so the API key never appears in the console log.
          withEnv(["FAIL_ON_CVSS=${params.OWASP_FAIL_ON_CVSS}"]) {
            sh '''
              set +x
              DC=$(command -v dependency-check.sh || command -v dependency-check)
              "$DC" \
                --project "netflow" \
                --scan backend --scan frontend \
                --suppression security/owasp-dependency-check/suppression.xml \
                --failOnCVSS "$FAIL_ON_CVSS" \
                --nvdApiKey "$NVD_API_KEY" \
                --format "HTML" --format "JSON" --format "JUNIT" \
                --out reports/dependency-check
            '''
          }
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'reports/dependency-check/*junit*.xml'
        }
      }
    }

    // 10 ------------------------------------------------- Trivy Filesystem Scan
    stage('Trivy Filesystem Scan') {
      steps {
        // Human-readable report (archived) + gating run that fails on threshold.
        sh """
          trivy fs --scanners vuln,secret,misconfig --severity ${params.TRIVY_SEVERITY} \
            --format table --output ${REPORTS_DIR}/trivy/fs-scan.txt \
            --ignorefile security/trivy/.trivyignore --no-progress .
        """
        sh """
          trivy fs --scanners vuln,secret,misconfig --severity ${params.TRIVY_SEVERITY} \
            --exit-code 1 --ignorefile security/trivy/.trivyignore --no-progress .
        """
      }
    }

    // 11 ------------------------------------------------------- Docker Image Build
    stage('Docker Image Build') {
      parallel {
        stage('backend') {
          steps {
            // Build with the immutable tag; label with commit for traceability.
            sh """
              docker build \
                --label org.opencontainers.image.revision=${GIT_SHA_FULL} \
                -t ${BACKEND_IMAGE}:${IMAGE_TAG} ./backend
            """
          }
        }
        stage('frontend') {
          steps {
            sh """
              docker build \
                --label org.opencontainers.image.revision=${GIT_SHA_FULL} \
                -t ${FRONTEND_IMAGE}:${IMAGE_TAG} ./frontend
            """
          }
        }
      }
    }

    // 12 --------------------------------------------- Trivy Container Image Scan
    stage('Trivy Container Image Scan') {
      steps {
        sh """
          trivy image --severity ${params.TRIVY_SEVERITY} \
            --format table --output ${REPORTS_DIR}/trivy/image-backend.txt \
            --ignorefile security/trivy/.trivyignore --no-progress ${BACKEND_IMAGE}:${IMAGE_TAG}
          trivy image --severity ${params.TRIVY_SEVERITY} --exit-code 1 \
            --ignorefile security/trivy/.trivyignore --no-progress ${BACKEND_IMAGE}:${IMAGE_TAG}
        """
        sh """
          trivy image --severity ${params.TRIVY_SEVERITY} \
            --format table --output ${REPORTS_DIR}/trivy/image-frontend.txt \
            --ignorefile security/trivy/.trivyignore --no-progress ${FRONTEND_IMAGE}:${IMAGE_TAG}
          trivy image --severity ${params.TRIVY_SEVERITY} --exit-code 1 \
            --ignorefile security/trivy/.trivyignore --no-progress ${FRONTEND_IMAGE}:${IMAGE_TAG}
        """
      }
    }

    // 13 ------------------------------------------------------------ Image Tagging
    stage('Image Tagging') {
      steps {
        // Only add an additional immutable, human-friendly tag: <branch>-<sha>.
        // Deliberately NO 'latest' tag for deployment.
        script {
          env.BRANCH_TAG = "${env.BRANCH_NAME ?: 'main'}-${env.GIT_SHA}".replaceAll('/', '-')
        }
        sh """
          docker tag ${BACKEND_IMAGE}:${IMAGE_TAG}  ${BACKEND_IMAGE}:${BRANCH_TAG}
          docker tag ${FRONTEND_IMAGE}:${IMAGE_TAG} ${FRONTEND_IMAGE}:${BRANCH_TAG}
        """
        echo "Images tagged: ${IMAGE_TAG} and ${BRANCH_TAG} (no 'latest')"
      }
    }

    // 14 --------------------------------------------- Push Image to Registry
    stage('Push Image to Registry') {
      options { retry(2) }
      steps {
        // ECR login via the agent's IAM role (preferred). set +x avoids echoing tokens.
        sh '''
          set +x
          aws ecr get-login-password --region ${AWS_REGION} \
            | docker login --username AWS --password-stdin ${ECR_REGISTRY}
        '''
        sh """
          docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
          docker push ${BACKEND_IMAGE}:${BRANCH_TAG}
          docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
          docker push ${FRONTEND_IMAGE}:${BRANCH_TAG}
        """
      }
    }

    // 15 ------------------------------------------------- GitOps Deployment Update
    stage('GitOps Deployment Update') {
      when { expression { return params.UPDATE_GITOPS } }
      options { retry(2) }
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'gitops-repo-credentials',
          usernameVariable: 'GIT_USER',
          passwordVariable: 'GIT_TOKEN')]) {
          // set +x so the token in the clone URL is never printed.
          sh '''
            set +e
            set +x
            REPO_HOST_PATH="${GITOPS_REPO#https://}"
            rm -rf gitops
            git clone --branch ${GITOPS_BRANCH} \
              "https://${GIT_USER}:${GIT_TOKEN}@${REPO_HOST_PATH}" gitops || exit 1
            set -e
            cd gitops/${GITOPS_OVERLAY}

            kustomize edit set image \
              netflow-backend=${BACKEND_IMAGE}:${IMAGE_TAG} \
              netflow-frontend=${FRONTEND_IMAGE}:${IMAGE_TAG}

            git config user.email "ci@netflow.local"
            git config user.name  "netflow-ci"
            git add kustomization.yaml
            git commit -m "ci: set images to ${IMAGE_TAG} [skip ci]" || { echo "No manifest change"; exit 0; }
            git push origin ${GITOPS_BRANCH}
          '''
        }
        echo "GitOps desired state updated to ${IMAGE_TAG}. ArgoCD will reconcile."
      }
    }
  }

  post {
    always {
      // Archive test/security reports regardless of outcome.
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true, fingerprint: true
      // Remove locally built images and clean the workspace safely.
      sh 'docker image prune -f || true'
      cleanWs(deleteDirs: true, notFailBuild: true)
    }
    success {
      echo "SUCCESS: ${IMAGE_TAG} built, scanned, pushed, and GitOps updated."
    }
    unstable {
      echo "UNSTABLE: review archived test/security reports."
    }
    failure {
      echo "FAILURE at stage '${env.STAGE_NAME}'. Nothing was promoted or deployed."
    }
  }
}
